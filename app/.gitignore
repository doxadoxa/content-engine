*.log
.DS_Store
# Every .env but the committed template. The list used to name three exact
# files, and a fourth — `.env.backup-before-tunnel`, written while putting the
# app behind a Cloudflare Tunnel — matched none of them and would have gone to
# GitHub with every vendor key and the database password in it. A pattern with
# one exception cannot be outgrown the same way.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
# Generated by Wayfinder from the route table during the build.
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
