# Local development runs in Docker (see docker-compose.yml), and the compose
# file sets the container-facing values for DB_HOST, REDIS_HOST and friends.
# What you set here is what the *host* sees — running `php artisan` or the
# suite outside the container — plus every API key, which reaches the
# containers through env_file.

APP_NAME="Avyo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8091
TRUSTED_PROXIES=127.0.0.1,::1

# Server-side HTTP is restricted to public addresses. Production defaults to
# HTTPS-only; local development keeps HTTP available for deliberately public
# test receivers. Never enable unresolved hosts outside the test suite.
OUTBOUND_REQUIRE_HTTPS=false
OUTBOUND_ALLOW_UNRESOLVED_HOSTS=false
OUTBOUND_ALLOWED_PORTS=80,443
# Stable HMAC key used only to index pull API tokens. Set this before creating
# pull channels and keep it unchanged when rotating APP_KEY.
PULL_TOKEN_HASH_KEY=

# Global queue operations are intentionally not available to every project
# member. Use a comma-separated allow-list of trusted system administrators.
HORIZON_ALLOWED_EMAILS=admin@content-engine.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres with pgvector. The ports below are the compose-published ones, so
# host tooling reaches the same database the containers use.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5437
DB_DATABASE=content_engine
DB_USERNAME=content_engine
DB_PASSWORD=secret
# The session timezone, issued as SET TIME ZONE on every connection. Leave it
# at UTC: the social tables store instants as timestamptz while the older ones
# use a plain timestamp, and comparing the two shifts by the session offset
# silently. Change this and the engine keeps working while its date arithmetic
# quietly moves.
DB_TIMEZONE=UTC

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Where generated and uploaded images land. `public` writes to the container's
# own storage/ directory, which is right for a laptop and wrong for anything
# that runs more than one container: a hero drawn by a worker is served by the
# web container, and on separate filesystems it is drawn and then 404s. On
# ephemeral pods it does not even survive the pod.
#
# `s3` is the answer for a real deployment, and works against any S3-compatible
# bucket — R2, Spaces, MinIO — not only AWS.
#
# AWS_URL is the public base for the links: Asset::url() asks the disk, and
# without it the links carry the bucket's raw endpoint rather than your CDN.
# AWS_ENDPOINT is only for non-AWS providers, and path-style addressing is what
# MinIO wants and what AWS does not.
#
# Note the disk is recorded per asset row, so changing this only affects new
# writes -- existing rows keep pointing at whatever disk wrote them.
MEDIA_DISK=public
# MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=
# AWS_URL=https://cdn.example.com
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# predis rather than the phpredis C extension, so no extra build step is needed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6384

# Mail. `resend` is the production value; this file ships `log` because it is
# also read from the host, where nothing overrides it. Inside the stack the
# question does not arise — docker-compose.yml pins MAIL_MAILER to Mailpit and
# `environment:` wins over `env_file:`, so a real key here cannot send from a
# container. A host-run `artisan tinker` has no such backstop, and development
# runs on invented addresses, some of which belong to real people.
MAIL_MAILER=log
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, with the DKIM and SPF
# records it hands you published. Resend refuses everything else, and since
# the notification is queued that refusal arrives as a job failing in Horizon
# rather than as an error on the screen of whoever just registered — so a
# wrong value here looks like mail that simply never comes. The placeholder
# is a local-only address that only Mailpit will ever accept.
MAIL_FROM_ADDRESS="engine@content-engine.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Unset, replies go to the from-address above, which is a send-only
# mailbox nobody reads; a password-reset mail is the one people do reply to.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="${APP_NAME}"

# One consequence of sending these from a worker rather than from the request:
# the verification and reset links are built from APP_URL, because a queued
# job has no request to take a hostname from. Inline, they followed whichever
# host the person actually used.
#
# That is the safer default — deriving a signed link from the request's Host
# header is how host-header injection gets into password-reset mail — but it
# does mean an installation reachable under two names, a tunnel and
# localhost:8091 say, mails APP_URL's name to everyone regardless of where
# they signed up. The link is signed with this installation's APP_KEY, so
# pointed at an environment that does not share that key it fails its
# signature check rather than verifying anything: a dead link, not a
# cross-environment account change. Set APP_URL to the host people actually
# reach this installation at.

# IMPORTANT: a queue worker boots the framework once and keeps the
# configuration it read then. Changing anything below fixes nothing until the
# workers restart — `docker compose restart horizon` — and until they do, the
# symptom is a provider rejecting a key that is plainly correct in this file.
#
# Model providers. The key belongs to the provider named in
# config/laragent.php; which model each pipeline role uses is
# config/models.php. Without a key the engine runs and every step that
# calls a model fails on authentication — which is a working engine and a
# missing credential, not a broken build.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Keyword data for the research pipeline. Without it research fails at its
# first step; everything the suite asserts runs through the fake.
#
# DATAFORSEO_PASSWORD is the API password from https://app.dataforseo.com/api-access,
# which is not the password you sign into the site with. Both are needed.
KEYWORD_SOURCE=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 'suggestions' expands the seed phrase (what Ahrefs matching-terms did);
# 'ideas' widens to the seed's product category. Start with suggestions and
# only reach for ideas if the pool comes back too thin to plan a month from.
DATAFORSEO_KEYWORD_ENDPOINT=suggestions

# The way back. Set KEYWORD_SOURCE=ahrefs to put the old adapter behind the
# port again — the thresholds in config/research.php were calibrated against
# Ahrefs numbers, and until they are re-measured this is the rollback.
AHREFS_API_TOKEN=

# This application's OAuth client, which identifies *us* to Google. The grant
# it obtains belongs to a project: each project's owner connects their own
# Search Console and GA4 from that project's settings screen, and the tokens
# live encrypted in `project_integrations`. Two projects are two different
# people's websites, so one shared credential here is not an option.
#
# In Google Cloud Console: enable the Search Console API, the Analytics Admin
# API and the Analytics Data API, then create a Web application OAuth client
# whose authorised redirect URI matches GOOGLE_REDIRECT_URI exactly — Google
# compares it as a string, scheme and port included.
#
# Without these the settings panel says so and nothing else changes: the
# feedback pipeline's two fetch steps skip rather than fail, because a project
# whose owner has not connected Google is not a broken project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/integrations/google/callback"

# Whether this installation runs the social presence at all. Off by default,
# because a fresh installation has no Meta app and there is nothing honest for
# the feature to do without one.
#
# Off, the feature is absent rather than idle: no social contour is scheduled,
# the Threads webhook and OAuth routes do not exist, Threads is not offered as a
# channel type, and the Today and Conversations screens are out of the
# navigation. The rest of the engine — articles, delivery, feedback — is
# untouched.
#
# Turning it on needs two things. A Meta app with Threads API access and all
# five scopes listed below, filled into THREADS_APP_ID and THREADS_APP_SECRET;
# and then, per project, an operator running the connect flow on the project
# settings screen (Projects → Edit → Threads), because a token is granted per
# account and nothing can listen or publish until one exists.
SOCIAL_PRESENCE_ENABLED=false

# Threads, for the social presence feature (§9 of the social-presence spec).
#
# A Meta app with Threads API access. Unlike the Google pair, this grant is
# written through as well as read from: it publishes posts and sends the replies
# an operator approves. Without it no Threads account can be connected at all,
# which the project settings screen reports in place of offering a Connect
# button that could not work — the rest of the engine is unaffected.
#
# The app needs these scopes: threads_basic, threads_content_publish,
# threads_manage_insights, threads_manage_replies, threads_keyword_search.
# The last one is approved separately and is the one that matters most for
# listening: without it, search sees only this project's own posts.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI="${APP_URL}/integrations/threads/callback"

# Inbound webhooks: the secret Meta signs events with (X-Hub-Signature-256) and
# the token echoed back during the subscription handshake. Needed only to
# receive replies; publishing works without them.
THREADS_WEBHOOK_SECRET=
THREADS_WEBHOOK_VERIFY_TOKEN=

# Whether the API allows replying to somebody else's post via reply_to_id.
# Open question §11.1, unverified on a live account — leave this off until it is
# checked. Off, the engine drafts a reply and a human sends it; on, it can send
# directly. Nothing about the human-in-the-loop rule for replies changes either
# way: approval is always required (§4.2).
THREADS_REPLY_TO_FOREIGN=false

# Hero images (Seedream on AtlasCloud). Without it the image step *skips*
# rather than failing, so articles and social posts still go out.
ATLASCLOUD_API_KEY=
# How long one model call may take, in seconds, before it is given up on and
# the step's own retry budget takes over. Raise it only if a role legitimately
# needs longer than five minutes to answer — and keep it well under the worker
# timeout in config/horizon.php, because a call that outlives its worker is
# killed with nothing recorded. Left unbounded (which is what LarAgent's own
# driver does), one unresponsive provider parks an expensive worker for
# thirty-five minutes.
# MODEL_TIMEOUT=300
# MODEL_CONNECT_TIMEOUT=10

# Overrides for config/models.php, if you want a different model per role.
# MODEL_DRAFT=gpt-5
# MODEL_UTILITY=gpt-5-mini
# MODEL_FACTCHECK=gpt-5
#
# The social candidate pool is its own role, and the only place §4.3 of the
# social spec says an expensive model is spent deliberately: eight posts are
# written so that one exists, because "токены дешевле охвата". It is separate
# from MODEL_DRAFT so `pipeline:cost` can show what selection costs instead of
# hiding it inside article drafting — and so this is the one knob to turn down
# if the number ever looks wrong.
# MODEL_SOCIAL_CANDIDATES=gpt-5.6-sol

# Which price list the cost report uses. The current one is 2, read from the
# providers' own pricing pages on 7 August 2026. Bump this when you add a new
# version — never edit a published version's numbers, because runs already
# reference it and the point of the version is that history stays true.
#
# Note for 1 September 2026: Claude Sonnet 5's introductory $2/$10 ends and it
# returns to $3/$15. That needs a version 3.
# MODEL_PRICE_LIST_VERSION=2

# Per-picture cost, used by the cost report. Confirm against the vendor's
# pricing — a wrong number breaks nothing and quietly produces a plausible
# cost table.
# IMAGE_COST_MICROS=40000

# Pipeline queue names, if they must not collide with another stack.
# PIPELINE_QUEUE_CHEAP=pipeline
# PIPELINE_QUEUE_EXPENSIVE=pipeline-expensive
# PIPELINE_QUEUE_AUDIT=pipeline-audit

# --- Site audit ---------------------------------------------------------
#
# The site audit reads each project's own website: robots.txt, the sitemap,
# llms.txt, and every page the sitemap names. It needs no credentials to do
# any of that, so the section works out of the box.
#
# PAGESPEED_API_KEY is the exception, and it is genuinely optional. With it,
# the sweep asks Google's PageSpeed Insights for a Lighthouse score on a few
# pages; without it, page speed is scored from what our own crawler observed
# (time to first byte, HTML weight, images) and nothing is reported as slow
# merely because nobody measured it. Get a key from the Google Cloud console
# with the PageSpeed Insights API enabled.
PAGESPEED_API_KEY=
# PAGESPEED_STRATEGY=mobile
# PAGESPEED_MAX_PAGES=5

# How much of somebody else's site one sweep may read. These are limits on
# what this engine does to a customer's server: modest on purpose, and a
# sample rather than a crawl.
# AUDIT_MAX_PAGES=100
# AUDIT_MAX_LINKS=300
# AUDIT_REFRESH_AFTER_DAYS=7

# ------------------------------------------------------------------ Billing
#
# A subscription belongs to a *project*, and the Stripe customer is the account
# that pays for it — one saved card, one named subscription per project. See
# config/billing.php for the plans themselves, which are code rather than
# configuration because they are a decision and belong in review.
#
# Without these keys nothing breaks: entitlement is decided from local rows, and
# a plan assigned with `php artisan billing:assign <project> <plan>` works with
# no provider behind it at all. What stops working is checkout, the billing
# portal, and the reconciler.
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...

# The signing secret for /stripe/webhook. Cashier only verifies signatures when
# this is set, so leaving it empty in a deployment reachable from the internet
# means anyone who finds the path can cancel a customer's subscription.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Which Stripe price each plan is bought at. A plan marked self-serve with no
# price behind it sends people to a checkout for nothing, so the checkout
# refuses instead.
# STRIPE_PRICE_SMALL=price_...
# STRIPE_PRICE_MEDIUM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Which plan a new project's checkout is opened against. The free days are the
# same whichever it is, so this only decides what happens on day three.
# BILLING_DEFAULT_PLAN=medium

# The free window, in days, and how long a project keeps working after a payment
# fails. The card is taken at the end of the wizard and charged nothing that
# day; the first invoice falls due when the free days run out. Stripe requires a
# trial end at least 48 hours out, so anything under two days becomes two. Generation stops the moment a payment fails; publishing and reading run
# to the end of the grace, because approved work was already paid for.
# BILLING_TRIAL_DAYS=3
# BILLING_GRACE_DAYS=7
# BILLING_CURRENCY=eur

# Seeded on first boot of the app container. Local-only credentials.
SEED_ADMIN_EMAIL=admin@content-engine.test
SEED_ADMIN_NAME=Operator
SEED_ADMIN_PASSWORD=password

# ------------------------------------------------------------------ Sentry
#
# Where faults go. Left empty — as they ship — the SDK is a no-op on both
# sides: no network, no overhead, and the application behaves exactly as it did
# before Sentry was installed. That is the supported state for a local checkout
# and for CI, not a degraded one.
#
# Two projects, because they are two different runtimes with two different
# release artefacts. The first is the PHP one; it also carries the queue
# workers, the scheduler's cron check-ins, and anything written with
# `Log::error`. The second is the browser.
# SENTRY_LARAVEL_DSN=https://<key>@o0.ingest.de.sentry.io/0
# VITE_SENTRY_DSN=https://<key>@o0.ingest.de.sentry.io/0
#
# The tenth of traffic that gets a performance trace, and the tenth of *those*
# that also gets a profile — so roughly one request in a hundred is profiled.
# Errors are never sampled; only performance is. Profiling additionally needs
# the Excimer extension, which the Docker image has and a host PHP probably
# does not; without it nothing breaks and nothing profiles.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# The release, which has to be one string in three places: here, in the browser
# bundle, and on the source maps the build uploads. Sentry matches an event to
# its maps by this name, so a mismatch produces maps that exist and are never
# applied — indistinguishable, from the outside, from maps that failed to
# upload. The commit sha is the obvious choice.
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE="${SENTRY_RELEASE}"
# SENTRY_ENVIRONMENT="${APP_ENV}"
# VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
#
# Source-map upload, which happens at build time and nowhere else. The token is
# passed to `docker build` as a secret rather than being read from here — see
# the frontend stage of the Dockerfile — because an auth token in a build arg
# is an auth token in the image history.
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# Deliberately absent: SENTRY_SEND_DEFAULT_PII. Turning it on attaches request
# bodies, cookies, IP addresses and user emails to every event, which for this
# application means customers' drafts leaving it. config/sentry.php explains
# what is sent instead and why. It is not a tuning knob.

# Read by the frontend at build time for the browser tab title.
VITE_APP_NAME="${APP_NAME}"

# Host ports, shifted off the defaults so this stack can run alongside others.
CE_APP_PORT=8091
CE_DB_PORT=5437
CE_REDIS_PORT=6384
CE_MAIL_PORT=8026
